    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU por nodo",
      "description": "Porcentaje de sus núcleos en uso.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (instance) (1 - rate(node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"}[5m])) / count by (instance) (node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"}))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
