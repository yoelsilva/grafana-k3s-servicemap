{
  "annotations": {
    "list": []
  },
  "description": "Los nodos del clúster: cuánto hay y cuánto se usa de CPU, RAM y disco, para dimensionar. Para decidir, mira al menos 7 días.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Mapa de servicio",
      "type": "link",
      "icon": "apps",
      "tooltip": "Volver al mapa",
      "url": "/d/servicemap?var-cluster=${cluster}",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "asDropdown": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodos",
      "description": "Nodos con métricas ahora mismo.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (instance) (node_memory_MemTotal_bytes{cluster=\"$cluster\"}))",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Núcleos",
      "description": "Núcleos de CPU sumando todos los nodos.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(count by (instance) (node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"}))",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU usada p95",
      "description": "Núcleos en uso en todo el clúster: el 95 % del tiempo se usa esto o menos. Frente a «Núcleos», cuánto margen queda.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.95, (sum(sum by (instance) (1 - rate(node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"}[5m]))))[$__range:5m])",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CPU usada máxima",
      "description": "Núcleos en uso en todo el clúster, el pico más alto del rango (ventanas de 5 minutos).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum(sum by (instance) (1 - rate(node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"}[5m]))))[$__range:5m])",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "RAM",
      "description": "Memoria sumando todos los nodos.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (instance) (node_memory_MemTotal_bytes{cluster=\"$cluster\"}))",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "RAM usada máxima",
      "description": "Memoria en uso en todo el clúster, el pico del rango. En memoria manda el pico: no se puede estrangular como la CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 17,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum((max by (instance) (node_memory_MemTotal_bytes{cluster=\"$cluster\"}) - max by (instance) (node_memory_MemAvailable_bytes{cluster=\"$cluster\"}))))[$__range:5m])",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Disco más lleno",
      "description": "El `/` más ocupado de todos los nodos, ahora.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(((max by (instance) (node_filesystem_size_bytes{cluster=\"$cluster\", mountpoint=\"/\"}) - max by (instance) (node_filesystem_avail_bytes{cluster=\"$cluster\", mountpoint=\"/\"})) / max by (instance) (node_filesystem_size_bytes{cluster=\"$cluster\", mountpoint=\"/\"})))",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Por nodo",
      "description": "CPU y RAM en porcentaje de lo que tiene cada nodo, en el rango elegido. Amarillo desde el 70 %, rojo desde el 85 %. Carga por núcleo por encima de 1: hay más trabajo esperando del que el nodo despacha.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (instance) (node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"})",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(((sum by (instance) (1 - rate(node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"}[5m])) / count by (instance) (node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"})))[$__range:5m])",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.95, ((sum by (instance) (1 - rate(node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"}[5m])) / count by (instance) (node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"})))[$__range:5m])",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance) (node_memory_MemTotal_bytes{cluster=\"$cluster\"})",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((((max by (instance) (node_memory_MemTotal_bytes{cluster=\"$cluster\"}) - max by (instance) (node_memory_MemAvailable_bytes{cluster=\"$cluster\"})) / max by (instance) (node_memory_MemTotal_bytes{cluster=\"$cluster\"})))[$__range:5m])",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((((max by (instance) (node_memory_MemTotal_bytes{cluster=\"$cluster\"}) - max by (instance) (node_memory_MemAvailable_bytes{cluster=\"$cluster\"})) / max by (instance) (node_memory_MemTotal_bytes{cluster=\"$cluster\"})))[$__range:5m])",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance) (node_filesystem_size_bytes{cluster=\"$cluster\", mountpoint=\"/\"})",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "G"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "((max by (instance) (node_filesystem_size_bytes{cluster=\"$cluster\", mountpoint=\"/\"}) - max by (instance) (node_filesystem_avail_bytes{cluster=\"$cluster\", mountpoint=\"/\"})) / max by (instance) (node_filesystem_size_bytes{cluster=\"$cluster\", mountpoint=\"/\"}))",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "H"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(max by (instance) (node_filesystem_size_bytes{cluster=\"$cluster\", mountpoint=\"/\"}) - (max by (instance) (node_filesystem_size_bytes{cluster=\"$cluster\", mountpoint=\"/\"}) - max by (instance) (node_filesystem_avail_bytes{cluster=\"$cluster\", mountpoint=\"/\"}))) / ((deriv((max by (instance) (node_filesystem_size_bytes{cluster=\"$cluster\", mountpoint=\"/\"}) - max by (instance) (node_filesystem_avail_bytes{cluster=\"$cluster\", mountpoint=\"/\"}))[$__range:5m]) * 86400) > 0)",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "I"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.95, ((max by (instance) (node_load1{cluster=\"$cluster\"}) / count by (instance) (node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"})))[$__range:5m])",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "J"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Nodo",
            "desc": false
